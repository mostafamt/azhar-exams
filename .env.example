# Copy to .env and fill in. These identify the services; none of them is a secret.
# Never put an API secret here: everything named EXPO_PUBLIC_* is bundled into the app.

# Firebase console > Project settings > General > Your apps > Web app (same project as the dashboard)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cloudinary (profile photos): the dashboard's cloud name and the unsigned `azhar-avatars` preset
# (docs/profile-photo-plan.md §3.1)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_AVATAR_PRESET=
